{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyprTrack Desktop",
  "version": "2.0.3",
  "identifier": "com.hyprtrack.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HyprTrack Desktop",
        "width": 1520,
        "height": 960,
        "minWidth": 480,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Local Hyprland activity intelligence",
    "longDescription": "Track active Hyprland windows locally and explore activity analytics from a private SQLite database.",
    "copyright": "Copyright (c) 2026 Russell Daniel Paul",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
